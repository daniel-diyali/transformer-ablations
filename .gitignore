# Data artifacts — regenerated by data/prepare.py, never committed
data/
*.bin
tokenizer.json

# Run outputs — checkpoints and logs stay local.
# The two result tables and figures/ are committed, so findings stay diffable.
# `runs/*` rather than `runs/`: git does not descend into an ignored directory,
# so the negations below only work if the directory itself stays unignored.
runs/*
!runs/results.jsonl
!runs/context_eval.jsonl
*.pt
*.ckpt
wandb/

# Throwaway prototypes (see PLAN.md risk register)
spikes/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/

# OS / editor
.DS_Store
.vscode/
.idea/
